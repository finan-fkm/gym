# =============================================================
# Fit By Shahid - Server Environment Configuration (.env.example)
# Copy this file to .env or server/.env and fill in real values.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# =============================================================

# Server Port (Render sets this automatically in production)
PORT=5000

# Environment Mode: 'production' or 'development'
# In production, set to 'production'.
NODE_ENV=production

# Render PostgreSQL Internal Connection String
# MANDATORY in production (NODE_ENV=production). Ephemeral storage is strictly rejected.
# Example: postgresql://gym_db_user:secret_password@dpg-xxxxxx.oregon-postgres.render.com/gym_db
DATABASE_URL=postgresql://gym_db_user:password@dpg-xxxxxx.oregon-postgres.render.com/gym_db

# Secure JWT signing secret
# MANDATORY in production (minimum 32 characters, cryptographically random).
# Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_strong_random_jwt_secret_min_32_chars_fitbyshahid

# Allowed Frontend Origin for CORS (CLIENT_URL)
# MANDATORY in production. Set to your exact Vercel URL without trailing slash.
CLIENT_URL=https://gym-k1eimpi49-finan4.vercel.app

# Optional: additional allowed frontend URLs separated by commas
FRONTEND_URL=https://gym-k1eimpi49-finan4.vercel.app

# Initial Administrator Password (MANDATORY on first boot if admin does not exist)
# Minimum 8 characters. In production, 'password' or blank is strictly rejected.
INITIAL_ADMIN_PASSWORD=your_secure_admin_password_min_8_chars

# Demo Mock Clients Seeding (Optional, default: false)
# In production, set to 'false' to keep the gym database clean. Set to 'true' only if you want demo mock clients.
ENABLE_DEMO_SEED=false

# Optional Email Service for Password Resets (SMTP)
# If left blank, one-time secure reset tokens are provided directly upon request
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@fitbyshahid.com
