# =============================================================
# Fit By Shahid - Server Environment Configuration (.env.example)
# Copy this file to .env or server/.env and fill in real values.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# =============================================================

# Server Port (Render sets this automatically in production)
PORT=5000

# Environment Mode: 'production' or 'development'
# In production, set to 'production'.
NODE_ENV=production

# Render PostgreSQL Internal Connection String (Recommended)
# If left empty, server safely falls back to resilient local JSON database mode.
# Example: postgresql://gym_db_user:password@dpg-xxxxxx.oregon-postgres.render.com/gym_db
DATABASE_URL=

# Secure JWT signing secret (minimum 32 characters, cryptographically random)
# Example generation: crypto.randomBytes(32).toString('hex')
JWT_SECRET=your_strong_random_jwt_secret_min_32_chars_fitbyshahid

# Allowed Frontend Origins for CORS (CLIENT_URL or FRONTEND_URL)
# Matches deployed frontend URL (e.g. Vercel) and development origins
CLIENT_URL=https://gym-k1eimpi49-finan4.vercel.app
FRONTEND_URL=https://gym-k1eimpi49-finan4.vercel.app,https://gym-seven-rose.vercel.app,http://localhost:5173,http://localhost:3000

# Initial Admin Password (used only upon first boot if admin record does not exist)
INITIAL_ADMIN_PASSWORD=

# Optional Email Service for Password Resets (SMTP)
# If left blank, one-time secure reset tokens are provided directly upon request
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@fitbyshahid.com
